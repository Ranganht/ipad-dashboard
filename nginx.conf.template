server {
    listen 80;
    server_name _;

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }

    location /ha/ {
        proxy_pass http://host.docker.internal:8123/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header Authorization "Bearer ${HA_TOKEN}";
    }
}